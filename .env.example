# ==============================================================================
# J.A.R.V.I.S. Environment Configuration
# Place this .env file in the project root directory (same folder as docker-compose.yml)
# ==============================================================================

# Database Configurations (Docker Compose defaults to the 'postgres' service)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/chatbot

# Backend API Key Authentication
# Optional: Pre-define a secret key for API authentication.
# If omitted or left empty, a secure key is auto-generated on first run and saved to data/.api_key.
# Clients authenticate via 'X-API-Key: <key>', 'Authorization: Bearer <key>', or '?api_key=<key>'
API_KEY=

# Google Gemini API Key (Required for default Gemini model)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional keys for other LLM providers:
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tavily Search API Key (Required for Web Search functionality)
TAVILY_API_KEY=your_tavily_api_key_here

# Telegram Configurations
# Note: If these are not configured, the Telegram dispatch tool runs in Simulation Mode.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=jarvis-backend
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Timezone Configuration (e.g., America/New_York, Europe/London, Asia/Tokyo)
USER_TIMEZONE=America/New_York

# CORS Allowed Origins (JSON array or comma-separated, default: ["*"])
CORS_ORIGINS=["*"]

# Checkpoint Retention & Auto-Cleanup
# Inactivity threshold in hours before a chat thread's checkpoints are automatically purged (default: 24)
CHECKPOINT_RETENTION_HOURS=24
# How often (in hours) the background cleanup worker scans for inactive threads (default: 1)
CHECKPOINT_CLEANUP_INTERVAL_HOURS=1

# Optional Frontend Configuration (Default connects to backend on port 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000
